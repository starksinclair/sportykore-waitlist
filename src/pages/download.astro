---
import Layout from '../layouts/Layout.astro';

const storeLinks = {
	ios: 'https://apps.apple.com/us/app/sportykore/id6782519736',
	android: 'https://play.google.com/store/apps/details?id=com.nzenwata.sportykoreapp',
	download: 'https://sportykore.com/download',
};

export const prerender = true;
---

<Layout
	title="Get Sportykore"
	description="Download Sportykore for Android on Google Play or iPhone and iPad on the App Store. One app for live scores, standings, and player profiles."
	pathname="/download"
	ogImage="/og/og-download.png"
	ogImageAlt="Get Sportykore on the App Store or Google Play."
>
	<main id="main">
		<section class="bg-stripe-hero px-5 py-12 text-white sm:px-8 lg:min-h-[calc(100vh-80px)] lg:py-16">
			<div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-[1fr_360px]">
				<div class="space-y-6">
					<a href="/" class="wordmark inline-block text-4xl text-gold-score">Sportykore</a>
					<div class="max-w-2xl space-y-4">
						<p class="eyebrow text-gold-soft">Available now</p>
						<h1 class="display-1 text-balance">
							Get Sportykore, run your football league from your phone.
						</h1>
						<p class="max-w-xl text-[1.0625rem] leading-relaxed text-white/74">
							Live scores, automatic standings, match-day tools, and permanent player
							profiles for grassroots football competitions.
						</p>
					</div>

					<div class="flex flex-col gap-3 sm:flex-row">
						<a
							href={storeLinks.ios}
							class="store-badge"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Download Sportykore on the App Store"
						>
							<span class="store-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="currentColor">
									<path d="M16.15 2.2c.05.58-.17 1.18-.55 1.66-.42.53-1.13.94-1.79.89-.08-.56.2-1.17.58-1.61.43-.5 1.18-.88 1.76-.94ZM20.08 17.46c-.34.78-.51 1.13-.94 1.82-.61.94-1.48 2.12-2.55 2.13-.96.01-1.2-.62-2.5-.61-1.29.01-1.56.62-2.51.61-1.07-.01-1.9-1.07-2.52-2.01-1.72-2.63-1.9-5.73-.84-7.37.75-1.16 1.94-1.84 3.06-1.84 1.14 0 1.86.63 2.81.63.91 0 1.47-.63 2.79-.63 1 0 2.06.54 2.81 1.48-2.47 1.35-2.07 4.87.39 5.79Z" />
								</svg>
							</span>
							<span>
								<span class="store-kicker">Download on the</span>
								<span class="store-label">App Store</span>
							</span>
						</a>
						<a
							href={storeLinks.android}
							class="store-badge"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Get Sportykore on Google Play"
						>
							<span class="store-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="currentColor">
									<path d="M4.1 2.8c-.25.27-.4.68-.4 1.2v16c0 .52.15.93.42 1.2l.08.07 8.95-9.15v-.24L4.18 2.72l-.08.08Zm12.03 6.25-2.98 3.07v.24l2.99 3.06 3.56-2.04c1.02-.58 1.02-1.54 0-2.13l-3.57-2.2ZM5.17 22.05c.4.16.92.09 1.48-.23l8.44-4.84-3.03-3.1-6.89 8.17Zm6.89-11.93 3.03-3.1-8.44-4.84c-.56-.32-1.08-.39-1.48-.23l6.89 8.17Z" />
								</svg>
							</span>
							<span>
								<span class="store-kicker">Get it on</span>
								<span class="store-label">Google Play</span>
							</span>
						</a>
					</div>

					<p class="text-sm font-semibold text-gold-soft">
						Android and iOS are available now. Share this one link with any player,
						coach, or organizer.
					</p>
				</div>

				<aside class="rounded-[28px] border border-white/12 bg-white p-5 text-ink shadow-card">
					<div class="rounded-[22px] bg-chalk p-4">
						<img
							src="/download-qr.svg"
							alt={`QR code for ${storeLinks.download}`}
							width="256"
							height="256"
							class="mx-auto h-auto w-full max-w-64"
							loading="eager"
						/>
					</div>
					<h2 class="mt-4 font-display text-2xl font-bold">Scan from desktop</h2>
					<p class="mt-2 text-sm leading-relaxed text-muted">
						Point your phone camera at the code and Sportykore will open the right app
						store for your device. It points to {storeLinks.download}.
					</p>
				</aside>
			</div>
		</section>
	</main>

	<script define:vars={{ iosUrl: storeLinks.ios, androidUrl: storeLinks.android }}>
		(() => {
			const ua = navigator.userAgent || navigator.vendor || '';
			const isAndroid = /android/i.test(ua);
			const isIOS =
				/iPad|iPhone|iPod/.test(ua) ||
				(navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

			if (isAndroid) {
				window.location.replace(androidUrl);
				return;
			}

			if (isIOS) {
				window.location.replace(iosUrl);
			}
		})();
	</script>
</Layout>
