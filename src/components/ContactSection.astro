---
import ContactForm from './ContactForm.astro';
import { googlePlayUrl } from '../lib/site';
---

<section
	id="contact"
	class="bg-stripe-dark scroll-mt-20 px-5 py-20 sm:px-8 lg:py-24"
	aria-labelledby="contact-heading"
>
	<div class="mx-auto max-w-xl text-center" data-reveal>
		<p class="wordmark text-3xl text-gold-score">Sportykore</p>
		<h2 id="contact-heading" class="display-2 mt-4 text-white">Need help onboarding?</h2>
		<p class="mx-auto mt-4 max-w-md text-white/70">
			Android is available now on Google Play. Send us a message if you want help setting up
			a competition, school, club, or academy. iOS is coming soon.
		</p>
		<div class="mt-8">
			<a
				href={googlePlayUrl}
				class="btn-cta text-base"
				target="_blank"
				rel="noopener noreferrer"
			>
				Get it on Google Play
			</a>
		</div>
		<div class="mt-10">
			<ContactForm />
		</div>
	</div>
</section>
